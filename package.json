{
  "name": "chambapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:cli": "supabase",
    "db:login": "supabase login",
    "db:link": "node tools/supabase.mjs link",
    "db:plan": "node tools/supabase.mjs plan",
    "db:migrate": "node tools/supabase.mjs migrate",
    "db:status": "node tools/supabase.mjs status",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "npm --prefix tools/db-tests test",
    "db:test:install": "npm --prefix tools/db-tests ci --ignore-scripts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "supabase": "2.119.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.1"
  }
}
