{
  "name": "chambapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && npm run ext:pack && vite build",
    "build:local": "tsc --noEmit && vite build --mode edicion-local",
    "dev:local": "vite --host 127.0.0.1 --mode edicion-local",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src extension/src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extension.json",
    "db:cli": "supabase",
    "db:login": "supabase login",
    "db:link": "node tools/supabase.mjs link",
    "db:plan": "node tools/supabase.mjs plan",
    "db:migrate": "node tools/supabase.mjs migrate",
    "db:status": "node tools/supabase.mjs status",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "npm --prefix tools/db-tests test",
    "db:test:install": "npm --prefix tools/db-tests ci --ignore-scripts",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node tools/week-tests.mjs",
    "format": "prettier --write src tests extension/src extension/*.mjs extension/scripts tools/*.mjs package.json README.md docs/base-de-datos.md docs/extension.md",
    "format:check": "prettier --check src tests extension/src extension/*.mjs extension/scripts tools/*.mjs package.json README.md docs/base-de-datos.md docs/extension.md",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:pack": "node extension/build.mjs && node extension/scripts/pack.mjs",
    "ext:sign:firefox": "node extension/scripts/sign-firefox.mjs",
    "ext:icons": "node extension/scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.48.0",
    "luxon": "3.7.2",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/luxon": "3.7.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
