VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Referencia del proyecto (20 letras). Para CLI también se puede usar supabase/project.json.
SUPABASE_PROJECT_REF=
# No añadas tokens administrativos a variables VITE_. La CLI usa su propio login.

# Solo para firmar la extensión de Firefox (npm run ext:sign:firefox). Nunca como VITE_.
AMO_API_KEY=
AMO_API_SECRET=
