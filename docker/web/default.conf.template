# Chambapp local edition. ${CHAMBAPP_PORT} is the port published on 127.0.0.1
# (filled in by the nginx image's envsubst at start-up).
#
# There are no users or logins, so the API trusts whoever reaches it. Two checks keep
# web pages open in the browser out (CSRF and DNS rebinding):
#  - Host must be 127.0.0.1:<port> or localhost:<port>.
#  - On /rest/, Origin must be empty, this app, or a browser extension.

map $http_host $chambapp_host_ok {
    default 0;
    "127.0.0.1:${CHAMBAPP_PORT}" 1;
    "localhost:${CHAMBAPP_PORT}" 1;
}

map $http_origin $chambapp_origin_ok {
    default 0;
    "" 1;
    "http://127.0.0.1:${CHAMBAPP_PORT}" 1;
    "http://localhost:${CHAMBAPP_PORT}" 1;
    "~^chrome-extension://[a-p]{32}$" 1;
    "~^moz-extension://[0-9a-f-]{36}$" 1;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    # chambapp_copia_importar: up to 55 MiB of data (src/lib/serverBackup.ts) plus its wrapper.
    client_max_body_size 64m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    if ($chambapp_host_ok = 0) {
        return 403;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://nagerholidays.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /rest/v1/ {
        if ($chambapp_origin_ok = 0) {
            return 403;
        }
        proxy_pass http://api:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # PostgREST runs without JWT: every request is the single local user.
        proxy_set_header Authorization "";
        proxy_set_header apikey "";
        # Never let PostgREST grant cross-origin access to web pages.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;
        proxy_read_timeout 120s;
    }

    location /downloads/ {
        types {
            application/zip zip;
            application/x-xpinstall xpi;
            application/json json;
        }
        expires -1;
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        # The app shell is revalidated on every load, so an update shows up at once;
        # its hashed assets (/assets/) are cached for a year.
        expires -1;
        try_files $uri /index.html;
    }
}
