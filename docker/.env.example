# Copy as .env (next to docker-compose.yml) to change any of these. All optional.

# Port on 127.0.0.1 where Chambapp opens: http://127.0.0.1:47800
CHAMBAPP_PORT=47800

# Password of the internal database (never published outside Docker).
# Set it BEFORE the first start; changing it later requires changing it in the database too.
CHAMBAPP_DB_PASSWORD=chambapp-local

# Images: registry/owner and version (latest, or sha-<commit> to pin one).
CHAMBAPP_IMAGE_PREFIX=ghcr.io/herrera99
CHAMBAPP_TAG=latest

# Docker volume that holds your data.
CHAMBAPP_VOLUME=chambapp-local-data
